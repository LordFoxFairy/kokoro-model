{
  "name": "@kokoro/model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx src/interfaces/http/target-main.ts",
    "start": "tsx src/interfaces/http/target-main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "seed:builtin": "tsx src/bootstrap/seed-builtin.ts",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "coverage": "vitest run --coverage --no-file-parallelism",
    "postinstall": "prisma generate",
    "contract:lint": "buf lint contract",
    "contract:generate": "buf generate --template contract/buf.gen.yaml contract",
    "contract:check": "pnpm contract:lint && pnpm contract:generate",
    "rpc:dev": "tsx src/interfaces/rpc/main.ts",
    "db:postgres:migrate": "tsx scripts/migrate-postgres.ts",
    "db:postgres:local": "MODEL_DB_LOCAL=1 tsx scripts/migrate-postgres.ts",
    "smoke:postgres": "tsx scripts/smoke-postgres.ts",
    "smoke:rpc": "tsx scripts/smoke-rpc.ts",
    "http:dev": "tsx src/interfaces/http/target-main.ts",
    "docker:smoke": "docker compose up --build -d && sleep 5 && curl --fail http://127.0.0.1:4221/healthz",
    "legacy:http": "tsx src/interfaces/http/main.ts",
    "verify:standalone": "node scripts/verify-standalone.mjs && pnpm verify:contract-provenance",
    "verify:contract-provenance": "node scripts/verify-contract-provenance.mjs",
    "test:architecture": "vitest run test/architecture",
    "verify:release": "pnpm verify:standalone && pnpm contract:check && pnpm typecheck && pnpm test:architecture && pnpm test"
  },
  "dependencies": {
    "@connectrpc/connect": "2.0.0",
    "@connectrpc/connect-node": "2.0.0",
    "@kokoro/platform-kit": "workspace:*",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.6.2",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "2.14.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
