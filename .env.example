KOKORO_REDIS_URL="redis://127.0.0.1:56379"
MODEL_RESOLVE_CACHE_TTL_SECONDS=30
DATABASE_URL_MODEL="postgresql://kokoro_app:kokoro_local@127.0.0.1:55432/kokoro"
KOKORO_MODEL_RPC_PORT=4222
MODEL_DB_POOL_SIZE=10
KOKORO_MODEL_PORT=4221
KOKORO_MODEL_BASE_URL="http://kokoro-model:4221"

# Model 永远只提供 catalog/resolve，不连接 LiteLLM；LiteLLM 配置只注入实际执行方 Agent。
# 使用 transport=litellm 的 route 时，在 kokoro-agent 环境另行设置 KOKORO_LITELLM_ENABLED=1。

# Required when NODE_ENV=production; use one independent value per caller.
KOKORO_INTERNAL_SECRET_AGENT=CHANGE_ME_AGENT_SECRET
KOKORO_INTERNAL_SECRET_ADMIN=CHANGE_ME_ADMIN_SECRET
KOKORO_INTERNAL_SECRET_WEB_BFF=CHANGE_ME_WEB_BFF_SECRET

# Model 只依赖 PostgreSQL 与 Redis；入站 caller secret 由部署注入，不把其它业务服务地址写入本仓库。
# KOKORO_REDIS_URL="redis://127.0.0.1:56379"

# 模型 provider 凭据（接真模型时配;归 kokoro-model 域,经 gitignored .env 注入,绝不提交真值）。
# provider adapter 据此以 claude-code 别名调后端。例(GLM/OpenAI 兼容):
# GLM_API_KEY=CHANGE_ME
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
